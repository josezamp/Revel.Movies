{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RevelMovies": "Server=localhost;Database=Revel.Movies;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "MediaStorage": {
    "RootPath": "media",
    "MaxUploadBytes": 1073741824
  },
  "TvOptimization": {
    "Enabled": false,
    "FFmpegPath": "ffmpeg",
    "FFprobePath": "ffprobe",
    "TimeoutMinutes": 30,
    "Threads": 2
  },
  "Playback": {
    "SyncLeadTimeMs": 2000
  }
}
